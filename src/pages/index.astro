---
// The homepage. Layout only: every word comes from src/content/ and src/data/.
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SentenceMachine from '../components/SentenceMachine.astro';
import SentenceMachinePhone from '../components/SentenceMachinePhone.astro';
import ComingSoon from '../components/ComingSoon.astro';
import Logo from '../components/Logo.astro';
import Hero from '../components/Hero.astro';
import ResourceCard from '../components/ResourceCard.astro';
import Waitlist from '../components/Waitlist.astro';
import SignupDialog from '../components/SignupDialog.astro';
import ProBonoCase from '../components/ProBonoCase.astro';
import site from '../data/site.json';

const memos = (await getCollection('memos')).sort((a, b) => a.data.order - b.data.order);
const memoBodies = await Promise.all(memos.map(async (m) => (await render(m)).Content));

const cases = (await getCollection('cases', (c) => !c.data.draft)).sort((a, b) => a.data.order - b.data.order);
const caseBodies = await Promise.all(cases.map(async (c) => (await render(c)).Content));

// The footer line is plain text; the email address in it becomes a link.
const [footBefore, footAfter] = site.footerLine.includes(site.email)
  ? [site.footerLine.slice(0, site.footerLine.indexOf(site.email)), site.footerLine.slice(site.footerLine.indexOf(site.email) + site.email.length)]
  : [site.footerLine, null];


// While the site is unfinished, a "Coming soon" screen sits in front of it (see comingSoon in site.json).
const gated = site.comingSoon.enabled;
---
<Base>
  {gated && <ComingSoon />}
  <div class={gated ? 'col gated' : 'col'}>
    <header class="head">
      <Logo class="head-logo" size={52} />
      <h1>{site.firmName}</h1>
    </header>

    <main>
      <Hero />

      <div class="tabs" role="tablist" aria-label="Memos">
        {memos.map((m, i) => (
          <button class="tab" type="button" role="tab" id={`tab-${m.id}`} aria-controls={`memo-${m.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span><span class="lbl">{m.data.tab}</span>
          </button>
        ))}
      </div>

      <div class="stage">
        <div class="wash" aria-hidden="true"></div>

        <div class="panel">
          {memos.map((m, i) => {
            const Body = memoBodies[i];
            return (
              <div class="memo" role="tabpanel" id={`memo-${m.id}`} aria-labelledby={`tab-${m.id}`} tabindex="0" hidden={i !== 0}>
                <Body />
                {m.data.proBonoCase && <ProBonoCase />}
                {m.data.resource && <ResourceCard />}
                {m.data.cases && (
                  <div class="cases">
                    {cases.map((cs, k) => {
                      const CaseBody = caseBodies[k];
                      return (
                        <article class="case">
                          <p class="case-lab">{site.cases.label} · {cs.data.label}</p>
                          <h2 id={`case-h-${cs.id}`}>{cs.data.heading}</h2>
                          {cs.data.name ? (
                            <p class="case-who"><span class="case-name">{cs.data.name}</span>{cs.data.title && <>, <span class="case-title">{cs.data.title}</span></>}</p>
                          ) : cs.data.subtitle && <p class="case-sub">{cs.data.subtitle}</p>}
                          <button class="case-toggle" type="button" aria-expanded="true" aria-controls={`case-${cs.id}`} aria-describedby={`case-h-${cs.id}`} data-case-toggle data-open={site.cases.open} data-close={site.cases.close} hidden>{site.cases.close}</button>
                          <div class="case-body" id={`case-${cs.id}`}>
                            <p class="case-body-lab">{cs.data.bodyLabel}</p>
                            {cs.data.quote ? (
                              <figure class="case-text">
                                <blockquote><CaseBody /></blockquote>
                                {cs.data.name && <figcaption>— {cs.data.name}</figcaption>}
                              </figure>
                            ) : (
                              <div class="case-text"><CaseBody /></div>
                            )}
                          </div>
                        </article>
                      );
                    })}
                  </div>
                )}
              </div>
            );
          })}
        </div>

      </div>

      <section class="machine-sec" id="machine" aria-label={site.machineLabel}>
        <div class="machine-intro">
          <h2>{site.machine.heading}</h2>
          <p>{site.machine.subtitle}<span class="vh"> {site.machine.invite}</span></p>
        </div>
        <div class="fit fit-desk" data-fit data-w="760" data-h="553"><SentenceMachine /></div>
        <div class="fit fit-phone" data-fit data-w="358" data-h="420"><SentenceMachinePhone /></div>
      </section>

      <Waitlist />
    </main>
    <SignupDialog />

    <div class="closing">
      <footer class="foot">
        <Logo class="foot-logo" size={28} />
        <p>{footBefore}{footAfter !== null && <><a href={`mailto:${site.email}`}>{site.email}</a>{footAfter}</>}</p>
      </footer>
    </div>
  </div>

  <script>
    import '../scripts/analytics.js';
    import '../scripts/tabs.js';
    import '../scripts/cases.js';
    import '../scripts/footnotes.js';
    import '../scripts/signup.js';
    import '../scripts/machine.js';
    import '../scripts/gate.js';
  </script>
</Base>
