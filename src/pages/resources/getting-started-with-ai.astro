---
// MOCK: the free learning resource. Structure only; the words come from the generalized memo Shawn is writing.
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import site from '../../data/site.json';
const sections = [
  'What is generative AI, and what is it good for?',
  'Some basic safety tips',
  'Open the tool',
  'Three exercises',
  'What to take from this',
  'Where this goes next',
];
---
<Base title={`${site.resource.title} | ${site.firmName}`} description={site.resource.text}>
  <div class="col res-page">
    <header class="head">
      <a class="res-home" href="/"><Logo class="head-logo" size={52} /><span class="vh">Back to </span></a>
      <h1><a class="res-home-name" href="/">{site.firmName}</a></h1>
    </header>
    <main>
      <p class="res-back"><a href="/">← Back to the main page</a></p>
      <p class="hero-eyebrow">{site.resource.label}</p>
      <h2 class="res-page-title">{site.resource.title}</h2>
      <p class="res-page-intro">[Opening paragraph from the generalized memo: who this is for, how long it takes, and what you need before you start.]</p>
      <p class="res-meta"><span>About 1 hour</span><span>No client information needed</span><span>Part 1 of 2</span></p>
      <ol class="res-toc" aria-label="Sections">
        {sections.map((s, i) => <li><a href={`#s${i + 1}`}>{s}</a></li>)}
      </ol>
      {sections.map((s, i) => (
        <section class="res-sec" id={`s${i + 1}`}>
          <h3><span class="res-n">{i + 1}.</span> {s}</h3>
          <p>[Section text from the generalized memo.]</p>
        </section>
      ))}
      <div class="res-end">
        <p class="res-dl"><button class="btn" type="button" disabled aria-disabled="true">Download (Word) · coming soon</button></p>
        <p><strong>Part 2: coming soon.</strong> [One line on what Part 2 covers.]</p>
        <p>If you would like help putting this to work at your firm, <a href="/#waitlist">join our waitlist</a> or email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>
    </main>
    <footer class="closing"><div class="foot"><Logo class="foot-logo" size={28} /><p>{site.footerLine}</p></div></footer>
  </div>
</Base>
<style is:global>
  .res-home { color: inherit; display: block; }
  .res-home-name { color: inherit; text-decoration: none; }
  .res-page main { padding: 28px 0 64px; }
  .res-back { margin: 0 0 32px; font-size: 15px; }
  .res-page-title { margin: 14px 0 0; font-family: var(--display); font-weight: 400; font-size: 42px; line-height: 1.18; color: var(--ink); }
  .res-page-intro { margin: 18px 0 0; font-size: 18px; line-height: 1.65; color: var(--ink-2); }
  .res-meta { display: flex; flex-wrap: wrap; gap: 8px 22px; margin: 18px 0 0; font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--label); }
  .res-toc { margin: 32px 0 0; padding: 18px 0 18px 1.6em; border-top: 1px solid var(--gold); border-bottom: 1px solid var(--gold); display: grid; gap: 8px; font-size: 16px; }
  .res-sec { padding-top: 36px; scroll-margin-top: 16px; }
  .res-sec h3 { margin: 0; font-family: var(--display); font-weight: 400; font-size: 26px; line-height: 1.3; color: var(--ink); }
  .res-n { color: var(--gold); }
  .res-sec p { margin: 12px 0 0; font-size: 17px; line-height: 1.75; color: var(--muted); }
  .res-end { margin-top: 48px; padding-top: 28px; border-top: 3px double var(--gold); display: grid; gap: 14px; font-size: 16px; line-height: 1.6; }
  .res-end p { margin: 0; }
  .res-dl .btn[disabled] { opacity: 0.55; cursor: not-allowed; }
  @media (max-width: 799.98px) { .res-page-title { font-size: 32px; } .res-sec h3 { font-size: 22px; } }
</style>
