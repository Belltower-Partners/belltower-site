---
import site from '../data/site.json';
import '../styles/global.css';
import '../styles/machine.css';
import '../styles/gate.css';

interface Props { title?: string; description?: string }
const { title = site.title, description = site.description } = Astro.props;
const gated = site.comingSoon.enabled;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    {gated && <meta name="robots" content="noindex" />}
    {gated && (
      <script is:inline>
        // Coming-soon gate: a browser that already entered the password goes straight to the site.
        try { if (localStorage.getItem('belltower-unlocked') === '1') document.documentElement.setAttribute('data-unlocked', ''); } catch (e) {}
      </script>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=IBM+Plex+Serif:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <div class="site">
      <slot />
    </div>
  </body>
</html>
