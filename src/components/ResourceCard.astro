---
// The free-guide card under "Our work", "Our clients" and "Pro bono". Its button opens the sign-up form
// in guide mode; the download appears after the form. Words: site.json `resource`.
import site from '../data/site.json';
const r = site.resource;
---
<div class="res-card">
  <span class="res-lab">{r.label}</span>
  <span class="res-title">{r.title}</span>
  <span class="res-text">{r.text}</span>
  <a class="res-link" href="#waitlist" data-signup="guide">{r.button} <span aria-hidden="true">→</span></a>
</div>
