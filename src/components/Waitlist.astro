---
// The waitlist at the bottom of the page: a short note and a quiet button that opens the sign-up form.
// Words: site.json `waitlist`; the form itself is SignupDialog.astro.
import site from '../data/site.json';
const w = site.waitlist;
---
<section class="waitlist" id="waitlist" aria-labelledby="waitlist-head">
  <h2 class="wl-head" id="waitlist-head">{w.heading}</h2>
  <p class="wl-text">{w.text}</p>
  <p class="wl-act"><button class="btn btn-quiet" type="button" data-signup="waitlist">{w.button}</button></p>
  <p class="wl-email">{w.orEmail} <a href={`mailto:${site.email}`}>{site.email}</a></p>
</section>
