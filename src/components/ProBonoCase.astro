---
// The Law Foundation of Silicon Valley case study on "Pro bono". The one-page PDF is still under the Law
// Foundation's review, so only the headline and Melissa's (already approved) line are here; the PDF link is
// a placeholder until they sign off. Words: site.json `proBono.case`.
import site from '../data/site.json';
const c = site.proBono.case;
---
<article class="case pb-case">
  <p class="case-lab">{c.label}</p>
  <h2>{c.title}</h2>
  <p class="case-sub">{c.who}</p>
  <p class="pb-link">{c.link}</p>
</article>
