---
// The top of the page: three lines, each footnoted to the partner behind it, like a citation in a brief.
// A footnote chip opens its note; the note links to the full bio on "The team". Words: site.json `hero`.
import site from '../data/site.json';
const h = site.hero;
---
<section class="hero" aria-labelledby="hero-head">
  <p class="hero-eyebrow">{h.eyebrow}</p>
  <h2 class="hero-head" id="hero-head">
    {h.lines.map((l) => (
      <span class="hero-line">{l.text}<a class="fn-chip" href={`#fn-${l.note}`} id={`fnref-${l.note}`} aria-describedby={`fn-${l.note}-text`} data-fn={l.note}><span class="vh">Footnote </span>{l.note}</a></span>
    ))}
  </h2>
  <p class="hero-sentence">{h.sentence}</p>
  <p class="hero-act"><a class="btn" href="#waitlist" data-waitlist-link>{h.button}</a><span class="hero-aside">{h.aside}</span></p>
  <ol class="footnotes">
    {h.notes.map((n) => (
      <li id={`fn-${n.n}`} class="footnote">
        <span class="fn-num" aria-hidden="true">{n.n}</span>
        <span id={`fn-${n.n}-text`}><strong>{n.name}</strong> {n.text}</span>
        <a class="fn-bio" href="#tab-the-team" data-bio={n.name}>{h.bioLink}<span class="vh"> of {n.name}</span></a>
      </li>
    ))}
  </ol>
</section>
