---
// The top of the page: three lines, each footnoted to the partner behind it, like a citation in a brief.
// A footnote number opens a small note (a one-line summary and a link to that partner's bio on
// "The team"); on a desktop, pointing at the number opens it too. Words: site.json `hero`.
import site from '../data/site.json';
const h = site.hero;
---
<section class="hero" aria-labelledby="hero-head">
  <p class="hero-eyebrow">{h.eyebrow}</p>
  <h2 class="hero-head" id="hero-head">
    {h.lines.map((l) => (
      <span class="hero-line">{l.text}<span class="fn"><button class="fn-chip" type="button" aria-expanded="false" aria-controls={`fn-${l.note}`} data-fn><span class="vh">Footnote </span>{l.note}</button><span class="fn-pop" id={`fn-${l.note}`} hidden><span class="fn-pop-text"><strong>{l.bio}</strong> {l.summary}</span> <a class="fn-bio" href="#tab-the-team" data-bio={l.bio}>{h.bioLink}<span class="vh"> of {l.bio}</span><span aria-hidden="true">&nbsp;→</span></a></span></span></span>
    ))}
  </h2>
  <p class="hero-sentence">{h.sentence}</p>
  <p class="hero-aside">{h.aside} <a href="#waitlist" data-waitlist-link>{h.waitlistLink}<span aria-hidden="true"> →</span></a></p>
</section>
