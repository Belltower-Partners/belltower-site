{
  // Cloudflare Workers with static assets. There is no Worker script:
  // Cloudflare serves the files Astro builds into ./dist.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "belltower-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Needed for the preview link on each pull request (`wrangler preview`). Empty is fine.
  "previews": {}
}
